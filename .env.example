# Copy to .env.local and edit. Values shown are safe local defaults.

# WEBSITE URL (canonical public base for SEO/metadata; set your prod domain)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_VERCEL_URL=

# CI/Docker: NEXT_PUBLIC_APP_URL is inlined at build time. Set the GitHub
# repo variable NEXT_PUBLIC_APP_URL so CI builds use your real domain
# (Dockerfile default is http://localhost:3000).

# POSTGRES (consumed by docker-compose.yml; not required by the app yet)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nextjs-starter

# DATABASE URL (required once the data layer lands)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/nextjs-starter

# OBSERVABILITY (optional)
LOG_LEVEL=info
LOG_DIR=